[connection]
id={{ wifi_ssid }}
uuid={{ wifi_ssid | to_uuid }}
type=wifi
interface-name={{ wifi_interface | default('wlp3s0') }}

[wifi]
mode=infrastructure
ssid={{ wifi_ssid }}

[wifi-security]
auth-alg=open
key-mgmt=wpa-psk
psk={{ wifi_password }}

[ipv4]
method=auto

[ipv6]
addr-gen-mode=stable-privacy
method=auto